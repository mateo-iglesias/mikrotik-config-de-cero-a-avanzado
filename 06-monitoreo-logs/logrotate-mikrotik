# Rotacion de los logs del MikroTik
# Copiar a: /etc/logrotate.d/mikrotik
# Probar:   sudo logrotate -d /etc/logrotate.d/mikrotik
#
# Rota cada dia, guarda 30 dias comprimidos.

/var/log/mikrotik/*.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    create 0640 syslog adm
    sharedscripts
    postrotate
        /usr/lib/rsyslog/rsyslog-rotate
    endscript
}
